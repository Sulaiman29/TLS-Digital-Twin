# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Required ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Blockchain (optional) ---
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_ANCHOR_INTERVAL=5
