# ============================================
# Dockerfile for SUMO Publisher (headless)
# ============================================
FROM python:3.11-slim

# Install SUMO
RUN apt-get update && \
    apt-get install -y --no-install-recommends sumo sumo-tools && \
    rm -rf /var/lib/apt/lists/*

ENV SUMO_HOME=/usr/share/sumo
ENV SUMO_MODE=headless

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy blockchain module + Hardhat artifacts (needed at runtime)
COPY blockchain/ blockchain/

# Copy simulation network + publisher script
COPY tartu_network/ tartu_network/

# Copy .env (if present, dotenv will load it)
COPY .env* ./

CMD ["python", "tartu_network/scripts/realtime/realtime_publisher.py"]
