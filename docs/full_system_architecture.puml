@startuml Full_System_Architecture

skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 10
skinparam nodesep 60
skinparam ranksep 40

skinparam rectangle {
    BorderThickness 2
}

skinparam arrow {
    Color #475569
    Thickness 1.5
}

' ============================================================
' LAYER 1: SUMO Traffic Simulation
' ============================================================
rectangle "<b>Layer 1: SUMO Traffic Simulation</b>  (Python)" as SIM_LAYER #DBEAFE;line:3B82F6 {
    rectangle "SUMO Engine\n<i>Microscopic Simulator</i>\n<i>4-Intersection Tartu Corridor</i>" as SUMO #white;line:3B82F6
    rectangle "TraCI API\n<i>Step-by-step control</i>" as TRACI #white;line:3B82F6
    rectangle "Realtime Publisher\n<i>realtime_publisher.py</i>" as PUB #white;line:3B82F6

    SUMO -right-> TRACI
    TRACI -right-> PUB
}

' ============================================================
' MQTT BROKER (vertical bar on the right)
' ============================================================
rectangle "<b>MQTT Broker</b>\n<b>(Mosquitto)</b>\nlocalhost:1883\n─────────────\nmetrics/live\nvehicles/live\ntl/live\ncommands\nblockchain/live\naudit/live" as MQTT #F1F5F9;line:64748B

' ============================================================
' LAYER 2: AI Control Layer
' ============================================================
rectangle "<b>Layer 2: AI Control Layer</b>  (Python)" as AI_LAYER #EDE9FE;line:8B5CF6 {
    rectangle "Rule-Based Agent\n<i>tartu_traffic_agent.py</i>\n<i>Hysteresis policy</i>" as RULE #white;line:8B5CF6
    rectangle "LLM Multi-Agent System\n<i>tartu_agentic_brain.py</i>\n<b>4× GPT-4o-mini</b>\n<i>LangChain + LangGraph</i>" as LLM #white;line:8B5CF6

    RULE -[hidden]right- LLM
}

' ============================================================
' LAYER 3: Digital Twin Dashboard
' ============================================================
rectangle "<b>Layer 3: Digital Twin Dashboard</b>  (Elixir / Phoenix LiveView)" as DT_LAYER #D1FAE5;line:10B981 {
    rectangle "Tortoise311\nMQTT Client" as TORT #white;line:10B981
    rectangle "TrafficState\nGenServer\n<i>Live city state</i>" as GS #white;line:10B981
    rectangle "Phoenix\nPubSub" as PS #white;line:10B981
    rectangle "LiveView\n<i>Dashboard</i>\n<i>Audit Trail</i>" as LV #white;line:10B981
    rectangle "LeafletJS\nMap Hook\n<i>Browser</i>" as LEAF #white;line:10B981

    TORT -right-> GS
    GS -right-> PS
    PS -right-> LV
    LV -right-> LEAF
}

' ============================================================
' LAYER 4: Blockchain Security
' ============================================================
rectangle "<b>Layer 4: Blockchain Security</b>  (Ethereum / Ganache)" as BC_LAYER #FEF3C7;line:F59E0B {
    rectangle "BlockchainClient\n<i>Web3.py</i>\n<i>Hash-and-Anchor</i>" as BCC #white;line:F59E0B
    rectangle "TLSDecisionLog.sol\n<i>Immutable Decision</i>\n<i>Audit Trail</i>" as TLS_SC #white;line:F59E0B
    rectangle "AccessControl.sol\n<i>RBAC</i>\n<i>Admin · AI Agent</i>\n<i>Publisher · Auditor</i>" as AC_SC #white;line:F59E0B

    BCC -right-> TLS_SC
    BCC -right-> AC_SC
    TLS_SC -[hidden]right- AC_SC
}

' ============================================================
' CONNECTIONS: Simulation <-> MQTT
' ============================================================
PUB -right-> MQTT : <i>Publish</i>\nmetrics, vehicles,\nTL states, blockchain status
MQTT -left-> PUB : <i>Subscribe</i>\ncommands

' ============================================================
' CONNECTIONS: AI <-> MQTT
' ============================================================
MQTT -left-> AI_LAYER : <i>Subscribe</i>\nvehicles/live\ntl/live
AI_LAYER -right-> MQTT : <i>Publish</i>\nphase commands\naudit entries

' ============================================================
' CONNECTIONS: Dashboard <-> MQTT
' ============================================================
MQTT -left-> TORT : <i>Subscribe</i>\nall 5 topics

' ============================================================
' CONNECTIONS: Blockchain (dashed = optional/async)
' ============================================================
PUB -down..-> BCC : <i>anchor_data()</i>\n<i>anchor_batch()</i>\nData integrity anchoring
LLM -down..-> BCC : <i>logDecision()</i>\n<i>validateCommand()</i>\nDecision logging + RBAC

' ============================================================
' LAYOUT: Force vertical stacking
' ============================================================
SIM_LAYER -[hidden]down-> AI_LAYER
AI_LAYER -[hidden]down-> DT_LAYER
DT_LAYER -[hidden]down-> BC_LAYER

@enduml
