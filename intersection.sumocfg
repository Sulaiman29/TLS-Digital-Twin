<configuration>
  <input>
    <net-file value="intersection.net.xml"/>
    <route-files value="random.rou.xml"/>
    <additional-files value="intersection_tls.add.xml,detectors.add.xml"/>
  </input>

  <time>
    <begin value="0"/>
    <end value="3600"/>
    <step-length value="1"/>
  </time>

  <report>
    <verbose value="true"/>
    <no-step-log value="true"/>
  </report>
</configuration>
